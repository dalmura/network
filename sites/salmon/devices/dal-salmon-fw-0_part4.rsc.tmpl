#
# dal-salmon-fw-0
#

# 100 = GENERAL         = 192.168.72.0/25    = 126
# 101 = GUEST           = 192.168.72.128/26  =  62
# 102 = VPN             = 192.168.72.192/26  =  62
# 103 = SERVERS         = 192.168.73.0/25    = 126
# 104 = SERVERS_STAGING = 192.168.73.128/25  = 126
# 105 = IOT_INTERNET    = 192.168.74.0/25    = 126
# 106 = IOT_RESTRICTED  = 192.168.74.128/25  = 126
# 107 =                 = 192.168.75.0/25    = 126
# 108 = SERVICES        = 192.168.75.128/26  =  62
# 109 = MANAGEMENT      = 192.168.75.192/26  =  62

#
# App Global Configuration
#

/app/settings/set disk=usb1 auto-update=yes lan-bridge=CORE


#
# App - Tailscale
#

/app add yaml="name: dal-tailscale
descr: Tailscale for Mikrotik
page: https://github.com/Fluent-networks/tailscale-mikrotik
category: networking
default-credentials: none
services:
  tailscale:
    image: ghcr.io/fluent-networks/tailscale-mikrotik:latest
    volumes:
      - tailscale:/var/lib/tailscale
    environment:
      PASSWORD: '{{ tailscale_root_password }}'
      AUTH_KEY: '{{ tailscale_auth_key }}'
      ADVERTISE_ROUTES: '192.168.72.0/22'
      CONTAINER_GATEWAY: '192.168.75.193'
      UPDATE_TAILSCALE: 'Y'
      TAILSCALE_ARGS: '--accept-routes'
    restart: unless-stopped
"

/app/set dal-tailscale network-pvid=109 use-https=no network=CORE
/app/enable dal-tailscale
